{
  "name": "react-image-grid-gallery",
  "version": "3.1.4",
  "description": "A simple image gallery with lightbox for displaying a grid of images in React apps",
  "main": "dist/cjs/ImageGallery.js",
  "module": "dist/esm/ImageGallery.js",
  "types": "dist/esm/ImageGallery.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/ImageGallery.js",
      "import": "./dist/esm/ImageGallery.js",
      "types": "./dist/esm/ImageGallery.d.ts"
    }
  },
  "homepage": "https://codesweetly.com/react-image-grid-gallery",
  "author": "Oluwatobi Sofela <contact@codesweetly.com> (https://www.codesweetly.com)",
  "license": "MIT",
  "scripts": {
    "build": "rm -r dist && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "jest --config jest.config.cjs",
    "watch": "tsc -p tsconfig.esm.json --watch",
    "prepare": "husky && npm run build"
  },
  "files": [
    "./dist"
  ],
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/codesweetly"
  },
  "keywords": [
    "react",
    "image",
    "grid",
    "gallery",
    "lightbox",
    "component",
    "codesweetly"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codesweetly/react-image-grid-gallery.git"
  },
  "bugs": {
    "url": "https://github.com/codesweetly/react-image-grid-gallery/issues",
    "email": "contact@codesweetly.com"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^19.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^25.0.2"
  }
}
